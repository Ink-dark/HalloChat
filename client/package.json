{
  "name": "hallo-chat-client",
  "version": "0.2.0-alpha",
  "main": "electron-main.js",
  "private": true,
  "homepage": ".",
  "description": "HalloChat Client Application",
  "author": "Ink-dark",
  "build": {
    "extends": null,
    "appId": "io.github.Ink-dark.hallochat",
    "productName": "HalloChat",
    "asar": true,
    "icon": "../HalloChat.ico",
    "files": [
      "electron-main.js",
      "build/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      }
    ],
    "directories": {
      "buildResources": "public",
      "output": "app-build"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.2",
    "antd": "^5.26.1",
    "browserify-fs": "^1.0.0",
    "crypto-js": "^4.2.0",
    "electron-log": "^5.4.3",
    "i18next": "^25.7.4",
    "path-browserify": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.9.3",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.7.2",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "react-start": "craco start",
    "react-build": "craco build",
    "electron": "electron .",
    "dist": "powershell -Command \"Remove-Item -Force -Recurse app-build -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2; npm run react-build ; electron-builder build --windows\"",
    "start": "concurrently -k -n \"REACT,ELECTRON\" \"craco start --host 0.0.0.0 --port 3000\" \"wait-on http-get://localhost:3000 && electron .\"",
    "electron-start": "electron .",
    "build": "craco build && babel electron-main.js --out-dir build && copy electron-main.js build",
    "package": "powershell -Command \"Remove-Item -Force -Recurse dist; Start-Sleep -Seconds 5; electron-builder build --windows\"",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "overrides": {
    "typescript": "^4.9.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.1.2",
    "electron": "^37.2.5",
    "electron-builder": "^24.6.4",
    "rimraf": "^5.0.7",
    "wait-on": "^8.0.3"
  }
}
