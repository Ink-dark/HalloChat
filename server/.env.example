// 服务器配置
NODE_ENV=development
PORT=7932

// 数据库配置
MONGODB_URI=mongodb://localhost:27017/hallochat

// MongoDB配置
DB_HOST=localhost
DB_PORT=27017
DB_NAME=hallochat
DB_USER=
DB_PASS=
DB_AUTH_SOURCE=admin

// JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

// 日志配置
LOG_LEVEL=info

// Redis配置（可选）
REDIS_URL=redis://your-redis-host:6379

// 邮件配置（可选）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

// 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

// 安全配置
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

// MDNS配置
MDNS_ENABLED=true
MDNS_SERVICE_NAME=hallochat
MDNS_DISPLAY_NAME=My-HalloChat-Server