# 测试环境配置
NODE_ENV=test
PORT=7933

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/hallochat_test

# MongoDB配置
DB_HOST=localhost
DB_PORT=27017
DB_NAME=hallochat_test
DB_USER=
DB_PASS=
DB_AUTH_SOURCE=admin

# JWT配置
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=7d

# 日志配置
LOG_LEVEL=error

# Redis配置（测试环境使用内存Redis）
REDIS_URL=redis://localhost:6379

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads_test

# 安全配置
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000

# MDNS配置
MDNS_ENABLED=false